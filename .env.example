# Copy to .env and fill locally; never commit real credentials.
PG_DSN=host=localhost port=5433 dbname=mobile_money_project user=postgres
PG_ADMIN_DSN=host=localhost port=5433 dbname=postgres user=postgres
PGPASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_LOCAL_NEO4J_PASSWORD
NEO4J_HOME=YOUR_LOCAL_NEO4J_HOME
